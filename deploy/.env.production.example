# Copy to .env.production on the host (never commit it) and fill in. scripts/deploy.sh reads it.
DOMAIN=pulse.example.com
ACME_EMAIL=ops@example.com
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 24. Set before the first start: Postgres keeps the password it was created with.
POSTGRES_PASSWORD=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=pulse@example.com
# Optional, all off unless set: docs/OBSERVABILITY.md, docs/DATA_SAFETY.md, docs/CHANNELS.md
HEARTBEAT_URL=
SENTRY_DSN=
METRICS_TOKEN=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_HEARTBEAT_URL=
