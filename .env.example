# Copy to .env (`cp .env.example .env`). Every value here is a safe local-dev default.
# Production refuses to start unless SECRET_KEY, ALLOWED_HOSTS and DATABASE_URL are set.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# --- Data stores ------------------------------------------------------------
# Used when running without Docker; docker-compose overrides these with service hostnames.
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# --- Demo -------------------------------------------------------------------
# 1 = seed demo teams, users, services and 60 days of history on start (idempotent).
SEED_DEMO=1

# --- Email ------------------------------------------------------------------
# With docker compose, pages go to Mailpit (inbox: http://localhost:8025). Without Docker,
# leave EMAIL_HOST unset to print pages to the console, or set it to a real SMTP server.
# An explicit EMAIL_BACKEND always wins over EMAIL_HOST, so don't set it unless you mean to.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=pulse@localhost

# --- Rate limits -----------------------------------------------------------
THROTTLE_LOGIN=10/min
THROTTLE_EVENTS=120/min
# Reverse proxies you trust to append to X-Forwarded-For (the prod compose sets 1: its nginx).
# NUM_PROXIES=1

# --- Process tuning ---------------------------------------------------------
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=4

# --- Observability (all optional; see docs/OBSERVABILITY.md) ------------------------------
# /metrics returns 404 until a token is set; Prometheus sends it as a bearer token.
# METRICS_TOKEN=
# Dead-man's switch: Beat -> worker -> GET this URL each minute, only while healthy.
# HEARTBEAT_URL=https://hc-ping.com/your-uuid
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<git sha>
# Frontend (build-time): VITE_SENTRY_DSN, VITE_RELEASE

# --- Data safety (all optional; see docs/DATA_SAFETY.md) ----------------------------------
# RETENTION_DAYS=0            # 0 keeps everything; N deletes resolved incidents older than N days
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_S3_BUCKET=           # + BACKUP_S3_ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY to upload
# BACKUP_HEARTBEAT_URL=       # pinged after each successful backup
# DB_STATEMENT_TIMEOUT_MS=15000   DB_LOCK_TIMEOUT_MS=5000   DB_IDLE_IN_TX_TIMEOUT_MS=60000

# --- Notification channels (all optional; see docs/CHANNELS.md) ----------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=          # also verifies Twilio's webhook signatures
# TWILIO_FROM_NUMBER=+1...
# PUBLIC_BASE_URL=https://pulse.example.com   # the origin Twilio and recipients reach; links and callbacks use it
# ACTION_LINK_TTL_HOURS=12
# THROTTLE_PHONE_CODE=5/hour

# --- Security (see docs/SECURITY_MODEL.md) -------------------------------------------------
# REQUIRE_MFA_FOR_ADMINS=1      # default on in production settings, off for local dev
# SESSION_HOURS=12
# LOGIN_LOCKOUT_FAILURES=10
# LOGIN_LOCKOUT_SECONDS=900
# INTEGRATION_KEY_GRACE_HOURS=24
# CSP_MODE=enforce              # or report-only
